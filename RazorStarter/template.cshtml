<div class="row">
    @foreach(var col in Model.Columns)
  	{
  <div class="col-md-@(12 / Model.Settings.Columns) col-sm-@(24 / Model.Settings.Columns)">
        <div class="thumbnail">
            @if (!string.IsNullOrEmpty(Convert.ToString(col.Image)))
          	{          
            <img src="@col.Image" alt="@col.Title">
            }          	
            <div class="caption">
                @if (!string.IsNullOrEmpty(Convert.ToString(col.Title)))
              	{
                <h3>@col.Title</h3>
                }
                @col.Description            
            </div>          	
        </div>
    </div>
  	}
</div>
